{%- doc -%}
  Renders a social network glyph.

  Brand marks are filled shapes, not strokes, so they live here rather than in
  drivemist-icon.liquid, which is a stroke-based set. Paths are the official glyphs
  normalised to a 24x24 box so they optically match at the same size.

  @param {string} network - instagram, facebook, tiktok, pinterest, youtube or x
  @param {string} [class] - Classes for the svg
{%- enddoc -%}

{%- liquid
  assign co_net = network | default: 'instagram'
  assign co_class = class | default: 'w-[1.125rem] h-[1.125rem]'
-%}
<svg class="{{ co_class }} shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
