{%- doc -%}
  Renders one DriveMist product card.

  Extracted from drivemist-collection so the collection grid and the cart's
  recommendations render the same card rather than two copies that drift apart.

  @param {object} product - The product to render
  @param {string} section_id - Owning section id, for unique form and dialog ids
  @param {number} [index] - Position in the grid, used to stagger the reveal
  @param {string} [image_ratio] - Aspect ratio for the image
  @param {boolean} [show_badge] - Show the metafield badge / sold-out label
  @param {boolean} [show_add_to_cart] - Show the add-to-cart button
  @param {string} [add_to_cart_label] - Add-to-cart button text
  @param {string} [variant_dialog_title] - Heading for the variant picker
  @param {string} [button_label] - Secondary button text; omit to hide it
  @param {string} [rating_fallback] - Placeholder rating text
{%- enddoc -%}

{%- liquid
  assign co_section_id = section_id | default: 'card'
  assign co_index = index | default: 0
  assign co_ratio = image_ratio | default: '4 / 5'
  assign co_atc_label = add_to_cart_label
  assign co_dialog_title = variant_dialog_title
  assign co_button_label = button_label
  assign co_rating_fallback = rating_fallback
  assign co_show_badge = show_badge
  assign co_show_atc = show_add_to_cart
  assign co_sold_out = 'drivemist.collection.sold_out' | t

  assign p_variant = product.selected_or_first_available_variant
  assign p_sale = false
  if p_variant.compare_at_price > p_variant.price
    assign p_sale = true
    assign p_save_amount = p_variant.compare_at_price | minus: p_variant.price
  endif
  assign second_image = product.images[1]
-%}

<article
  class="co-reveal group relative co-flex flex-col"
  style="transition-delay: {{ co_index | modulo: 3 | times: 90 }}ms"
>
  <div class="relative">
    {% render 'drivemist-image',
      image: product.featured_image,
      ratio: co_ratio,
      class: 'co-media rounded-card',
      sizes: '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw',
      alt: product.title,
      placeholder: 'product-apparel-2'
    %}
    {%- if second_image != blank -%}
      <div class="pointer-events-none absolute inset-0 co-hide opacity-0 transition-opacity duration-500 pointer-fine:block group-hover:opacity-100">
        {% render 'drivemist-image',
          image: second_image,
          ratio: co_ratio,
          class: 'co-media rounded-card',
          sizes: '(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw',
          alt: product.title
        %}
      </div>
    {%- endif -%}
    {%- if p_sale -%}
      <span class="absolute right-4 top-4 rounded-full bg-sale px-3 py-1.5 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-sale-ink">
        {%- assign co_save = p_save_amount | money_without_trailing_zeros -%}{{ 'drivemist.save' | t: amount: co_save }}
      </span>
    {%- endif -%}
    {%- liquid
      comment
        Same custom.badge metafield the product page reads, so a badge set once
        shows on the card and the product page both.
      endcomment
      assign p_badge = product.metafields.custom.badge.value
      unless product.available
        assign p_badge = co_sold_out
      endunless
    -%}
    {%- if p_badge != blank and co_show_badge -%}
      <span class="absolute left-4 top-4 rounded-full bg-paper/95 px-3 py-1.5 text-[0.6875rem] font-medium uppercase tracking-[0.14em] text-ink shadow-lift backdrop-blur">
        {{ p_badge }}
      </span>
    {%- endif -%}
  </div>

  {%- liquid
    assign p_subtitle = product.metafields.custom.subtitle.value | default: product.metafields.descriptors.subtitle
    assign p_can_add = false
    assign p_needs_choice = false
    if product.available
      if product.variants.size == 1
        assign p_can_add = true
      else
        assign p_needs_choice = true
      endif
    endif
    assign p_form_id = 'CollCard-' | append: co_section_id | append: '-' | append: product.id
    assign p_dialog_id = 'CollVariants-' | append: co_section_id | append: '-' | append: product.id
  -%}
  <div class="mt-5 co-flex flex-1 flex-col">
    {% render 'drivemist-rating', product: product, size: 'xs', fallback: co_rating_fallback, class: 'mb-2 co-flex items-center gap-2' %}

    <h2 class="co-display text-[1.375rem] leading-tight sm:text-[1.5rem]">
      <a href="{{ product.url }}" class="before:absolute before:inset-0 before:content-['']">{{ product.title }}</a>
    </h2>

    {%- if p_subtitle != blank -%}
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{{ p_subtitle }}</p>
    {%- endif -%}

    <div class="mt-auto pt-4 co-flex items-baseline gap-2.5">
      {%- comment -%}
        No compare-at means nothing to contrast against, so the price carries the weight
        itself: larger and in ink rather than the accent reserved for a reduction.
      {%- endcomment -%}
      <span class="font-sub{% if p_sale %} text-[1.0625rem] font-semibold text-accent{% else %} text-[1.1875rem] font-semibold text-ink{% endif %}">
        {{- p_variant.price | money_without_trailing_zeros -}}
      </span>
      {%- if p_sale -%}
        <s class="text-[0.9375rem] text-muted/80">{{ p_variant.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
    </div>

    <div class="co-card-actions mt-5 co-flex items-stretch gap-2.5">
      {%- if p_can_add and co_show_atc -%}
        <product-form-component
          class="co-flex flex-1"
          data-section-id="{{ co_section_id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
          on:submit="/handleSubmit"
          data-quantity-default="1"
        >
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {%- form 'product', product, id: p_form_id, data-type: 'add-to-cart-form', class: 'w-full' -%}
            <input type="hidden" name="id" ref="variantId" value="{{ p_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            {% render 'add-to-cart-button-styles' %}
            {% render 'fly-to-cart-styles' %}
            {% render 'add-to-cart-button',
              id: p_form_id,
              class: 'add-to-cart-button co-card-atc',
              can_add_to_cart: true,
              show_icon: true,
              product: product,
              add_to_cart_text: co_atc_label
            %}
          {%- endform -%}
        </product-form-component>
      {%- endif -%}

      {%- if p_needs_choice and co_show_atc -%}
        <button
          type="button"
          class="button co-card-atc co-card-choose flex-1"
          data-co-variant-open
          aria-haspopup="dialog"
          aria-controls="{{ p_dialog_id }}"
        >
          <span aria-hidden="true" class="svg-wrapper add-to-cart-icon">
            {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
          </span>
          {{- co_atc_label -}}
        </button>
      {%- endif -%}

      {%- if co_button_label != blank -%}
        <a
          href="{{ product.url }}"
          class="co-card-btn co-card-btn-outline {% if co_show_atc and p_can_add or co_show_atc and p_needs_choice %}shrink-0{% else %}flex-1{% endif %}"
        >
          {{ co_button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if p_needs_choice and co_show_atc -%}
      {% render 'drivemist-variant-dialog',
        product: product,
        dialog_id: p_dialog_id,
        section_id: co_section_id,
        title: co_dialog_title,
        add_label: co_atc_label
      %}
    {%- endif -%}
  </div>
</article>
