{%- liquid
  assign co_kind = kind | default: 'lifestyle-1'
  case co_kind
    when 'lifestyle-2'
      assign co_scene = 'dusk'
    when 'lifestyle-1', 'image', 'hero'
      assign co_scene = 'night'
    else
      assign co_scene = 'studio'
  endcase
-%}
<svg
  class="co-ph co-ph--{{ co_scene }}{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 400 400"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="{{ label | default: 'DriveMist car humidifier' | escape }}"
>
  {%- if co_scene == 'studio' -%}
    <ellipse cx="200" cy="272" rx="150" ry="16" fill="#0b1220" opacity=".14" />
    <ellipse cx="200" cy="270" rx="118" ry="9" fill="#6fd3f0" opacity=".35" class="co-ph__glow" />
  {%- else -%}
    <g class="co-ph__bokeh">
      <circle cx="46" cy="96" r="14" fill="#6fd3f0" opacity=".16" />
      <circle cx="112" cy="70" r="7" fill="#ffc53d" opacity=".28" />
      <circle cx="318" cy="84" r="18" fill="#ff7a45" opacity=".14" />
      <circle cx="360" cy="140" r="8" fill="#6fd3f0" opacity=".26" />
      <circle cx="250" cy="52" r="5" fill="#ffffff" opacity=".3" />
      <circle cx="170" cy="118" r="10" fill="#8f7bff" opacity=".16" />
      <circle cx="74" cy="160" r="5" fill="#ffffff" opacity=".22" />
    </g>
    <path d="M0 292C90 276 150 270 200 270S310 276 400 292V400H0Z" fill="#05080f" opacity=".92" />
    <path d="M0 292C90 276 150 270 200 270S310 276 400 292" fill="none" stroke="#6fd3f0" stroke-opacity=".28" stroke-width="1.5" />
    <ellipse cx="200" cy="270" rx="120" ry="8" fill="#6fd3f0" opacity=".22" class="co-ph__glow" />
  {%- endif -%}

  <g transform="translate(-12 6) scale(6)">
    <path d="M57 38.6L72 34.6L72 44.2L57 41.2Z" fill="#6fd3f0" opacity=".14" class="co-ph__beam" />
    <g class="co-ph__mist" fill="none" stroke-linecap="round">
      <path d="M24 35.6C19 33 15 34.5 11.5 32C9 30.2 7.5 30.6 5.5 31.6C3.5 32.6 1.5 32 0 30.6" stroke-width="1.3" />
      <path d="M15.5 38.6C12.5 37.2 10.5 39 7.6 38C6 37.4 5 37.6 4 38.2C2.6 39 1 38.6 -.5 37.6" stroke-width="1.05" opacity=".7" />
      <path d="M14 42.2C12 41.6 10.5 43 8.5 42.4C7 42 5.8 42.4 4.6 43" stroke-width=".85" opacity=".45" />
    </g>
    <path d="M14 41.5C14 39.6 15 38.4 16.8 37.9L24 36C27.5 32.6 31.5 31 36 31C40 31 43.3 32.2 46.2 34.6L48.6 36.4L54 37.6C55.6 38 56.6 39.2 56.6 40.8L56.6 42.6C56.6 43.6 55.8 44.4 54.8 44.4L51.6 44.4A4.6 4.6 0 0 0 42.4 44.4L28.6 44.4A4.6 4.6 0 0 0 19.4 44.4L15.6 44.4C14.7 44.4 14 43.7 14 42.8Z" class="co-ph__body" />
    <path d="M28 36.2C30.5 34 33 33 36 33C39 33 41.6 34 43.6 35.6L44.6 36.4Z" class="co-ph__glass" />
    <path d="M30.4 35.2C32.2 34.1 34 33.7 35.6 33.7" fill="none" stroke="#ffffff" stroke-opacity=".5" stroke-width=".5" stroke-linecap="round" />
    <rect x="36.4" y="33" width="1.2" height="3.4" class="co-ph__body" />
    <path d="M17 40.6H54" fill="none" stroke="#ffffff" stroke-opacity=".12" stroke-width=".5" />
    <circle cx="24" cy="44.4" r="3.7" class="co-ph__tyre" /><circle cx="24" cy="44.4" r="1.9" class="co-ph__rim" />
    <circle cx="47" cy="44.4" r="3.7" class="co-ph__tyre" /><circle cx="47" cy="44.4" r="1.9" class="co-ph__rim" />
    <rect x="53.6" y="38.8" width="2.6" height="1.5" rx=".75" fill="#6fd3f0" />
    <rect x="14.4" y="39" width="1.8" height="1.5" rx=".75" fill="#ff7a45" />
  </g>
</svg>
