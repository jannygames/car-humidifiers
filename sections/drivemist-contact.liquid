{%- liquid
  assign s = section.settings
-%}

<section
  class="co {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"
>
  <div class="co-container co-section">
    <div class="co-grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-20">
      <div class="co-reveal">
        {%- if s.eyebrow != blank -%}
          <p class="co-eyebrow text-accent">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="co-display mt-4 text-[clamp(1.85rem,1.1rem+3.1vw,2.75rem)]">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <div class="co-rte mt-5 text-[1rem] leading-relaxed text-muted">{{ s.intro }}</div>
        {%- endif -%}

        {%- comment -%}
          Trading name, address and contact, as its own panel at the top of the contact
          section. MakeCommerce asked for these to sit here rather than in the footer or
          the terms page, so a customer finds them the moment they look for help.
        {%- endcomment -%}
        {%- if s.business_details != blank -%}
          <div class="mt-8 rounded-card bg-accent-wash p-6 text-ink sm:p-7" data-co-business-details>
            <div class="co-flex items-start gap-4">
              <span class="mt-0.5 co-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-paper text-accent">
                {% render 'drivemist-icon', icon: 'box', class: 'w-4 h-4' %}
              </span>
              <div class="min-w-0">
                {%- if s.business_title != blank -%}
                  <p class="font-sub text-[0.9375rem] font-medium">{{ s.business_title }}</p>
                {%- endif -%}
                <div class="co-rte mt-2 text-[0.9375rem] leading-relaxed">{{ s.business_details }}</div>
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- if s.show_social -%}
          <div class="mt-8">
            {%- if s.social_title != blank -%}
              <p class="co-eyebrow text-accent">{{ s.social_title }}</p>
            {%- endif -%}
            {% render 'drivemist-social-links', class: 'mt-4 co-flex flex-wrap items-center gap-2.5 co-social-light' %}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="mt-9 co-flex flex-col divide-y divide-current/10 border-y border-current/10">
            {%- for block in section.blocks -%}
              <div class="co-flex items-start gap-4 py-5" {{ block.shopify_attributes }}>
                <span class="mt-0.5 co-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-wash text-accent">
                  {% render 'drivemist-icon', icon: block.settings.icon, class: 'w-4 h-4' %}
                </span>
                <span class="co-flex flex-col gap-1">
                  <span class="font-sub text-[0.9375rem] font-medium">{{ block.settings.title }}</span>
                  <span class="co-rte text-[0.9375rem] leading-relaxed text-muted">{{ block.settings.text }}</span>
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="co-reveal rounded-card border border-current/12 bg-paper p-6 text-ink sm:p-9">
        {%- form 'contact', id: 'DriveMistContact' -%}
          {%- if form.posted_successfully? -%}
            <p class="mb-6 co-flex items-center gap-2 rounded-2xl bg-accent-wash px-5 py-4 text-[0.9375rem] text-accent">
              {% render 'drivemist-icon', icon: 'check-circle', class: 'w-4 h-4' %}
              {{ s.success_text }}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <p class="mb-6 rounded-2xl bg-accent-wash px-5 py-4 text-[0.875rem] text-accent">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}

          <div class="co-grid gap-4 sm:grid-cols-2">
            <label class="co-flex flex-col gap-2">
              <span class="co-eyebrow text-ink/70">{{ 'drivemist.contact.name' | t }}</span>
              <input
                type="text"
                name="contact[name]"
                value="{{ form.name }}"
                autocomplete="name"
                placeholder="{{ 'drivemist.contact.name_placeholder' | t }}"
                class="co-input h-[3.25rem] rounded-xl px-4"
              >
            </label>
            <label class="co-flex flex-col gap-2">
              <span class="co-eyebrow text-ink/70">{{ 'drivemist.contact.email' | t }}</span>
              <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                autocomplete="email"
                placeholder="{{ 'drivemist.contact.email_placeholder' | t }}"
                required
                class="co-input h-[3.25rem] rounded-xl px-4"
              >
            </label>
          </div>

          <label class="mt-4 co-flex flex-col gap-2">
            <span class="co-eyebrow text-ink/70">{{ 'drivemist.contact.order_number_optional' | t }}</span>
            <input
              type="text"
              name="contact[order]"
              placeholder="{{ 'drivemist.contact.order_number_placeholder' | t }}"
              class="co-input h-[3.25rem] rounded-xl px-4"
            >
          </label>

          <label class="mt-4 co-flex flex-col gap-2">
            <span class="co-eyebrow text-ink/70">{{ 'drivemist.contact.message' | t }}</span>
            <textarea
              name="contact[body]"
              rows="6"
              placeholder="{{ 'drivemist.contact.message_placeholder' | t }}"
              required
              class="co-input rounded-xl px-4 py-3.5"
            >{{ form.body }}</textarea>
          </label>

          <button type="submit" class="co-btn co-btn-primary mt-6 w-full">{{ s.button_label }}</button>

          {%- if s.disclaimer != blank -%}
            <p class="mt-4 text-center text-[0.75rem] leading-relaxed text-muted">{{ s.disclaimer }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DriveMist contact",
  "tag": "section",
  "class": "drivemist-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text",
      "default": "<p>Ask us about models, set-up, fragrance oils, delivery or returns. Include your order number if your message is about a purchase.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true,
      "info": "URLs come from Theme settings → DriveMist brand → Social media."
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social links title",
      "default": "Sekite mus"
    },
    {
      "type": "text",
      "id": "business_title",
      "label": "Business details title",
      "default": "Rekvizitai"
    },
    {
      "type": "richtext",
      "id": "business_details",
      "label": "Business details",
      "default": "<p>DriveMist · [Legal business name], Reg. No. [0000000]<br/>[Street address], [City], [Country]<br/>info@drivemist.com</p>",
      "info": "Trading name, address and a customer-service contact. Payment providers require these to be quick to find."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send my message"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks – your message is with our team. We’ll be in touch within 24 hours."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "We will only use your details to respond to your enquiry."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "shell",
          "label": "Shell"
        }
      ],
      "default": "paper"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Customer support"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use the form above to contact our friendly team.</p>"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "mail",
              "label": "Mail"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "refresh",
              "label": "Returns"
            },
            {
              "value": "globe",
              "label": "Globe"
            },
            {
              "value": "box",
              "label": "Business details"
            },
            {
              "value": "car",
              "label": "Car"
            },
            {
              "value": "mist",
              "label": "Mist"
            },
            {
              "value": "wind",
              "label": "Airflow"
            },
            {
              "value": "usb",
              "label": "USB power"
            },
            {
              "value": "gauge",
              "label": "Gauge"
            },
            {
              "value": "bolt",
              "label": "Power"
            },
            {
              "value": "bulb",
              "label": "Lights"
            },
            {
              "value": "quiet",
              "label": "Quiet"
            },
            {
              "value": "steering",
              "label": "Steering wheel"
            },
            {
              "value": "key",
              "label": "Key"
            },
            {
              "value": "timer",
              "label": "Timer"
            },
            {
              "value": "trophy",
              "label": "Trophy"
            }
          ],
          "default": "mail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DriveMist contact",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "title": "Customer support",
            "text": "<p>Use the form above to contact our friendly team.</p>",
            "icon": "mail"
          }
        },
        {
          "type": "detail",
          "settings": {
            "title": "Support hours",
            "text": "<p>Our team answers enquiries on working days.</p>",
            "icon": "clock"
          }
        },
        {
          "type": "detail",
          "settings": {
            "title": "Track your order",
            "text": "<p>We send tracking details after your parcel has been dispatched.</p>",
            "icon": "truck"
          }
        }
      ]
    }
  ]
}
{% endschema %}
