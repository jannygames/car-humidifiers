{%- liquid
  assign s = section.settings
-%}

<section
  class="co {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"

  {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}
>
  <div class="co-container co-section">
    {%- if s.heading != blank -%}
      {% render 'drivemist-section-header', eyebrow: s.eyebrow, heading: s.heading, intro: s.intro, align: 'center' %}
    {%- endif -%}

    {%- liquid
      comment
        One row on mobile that advances itself, a plain grid from sm up. The blocks are
        rendered twice so the mobile track can loop without a visible jump back to the
        start; the second pass is hidden on desktop and out of the accessibility tree.
      endcomment
      if s.mobile_carousel
        assign passes = 2
      else
        assign passes = 1
      endif
    -%}
    <div
      class="{% if s.mobile_carousel %}co-snap-track co-scrollbar-none{% else %}co-grid{% endif %} gap-8 sm:grid sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 {% if s.heading != blank %}mt-12{% endif %}"
      {% if s.mobile_carousel %}
        data-co-autoscroll
        data-co-autoscroll-interval="{{ s.carousel_speed }}"
        style="--co-snap-item: {{ s.carousel_item_width }}vw;"
      {% endif %}
    >
      {%- for pass in (1..passes) -%}
        {%- for block in section.blocks -%}
          <div
            class="co-reveal co-flex flex-col gap-3 {% if s.mobile_carousel %}co-snap-item{% endif %}{% if pass == 2 %} sm:hidden{% endif %} {% if s.alignment == 'center' %}items-center text-center{% endif %}"
            style="transition-delay: {{ forloop.index0 | times: 80 }}ms"
            {% if pass == 2 %}aria-hidden="true"{% else %}{{ block.shopify_attributes }}{% endif %}
          >
            <span class="text-accent">{% render 'drivemist-icon', icon: block.settings.icon, class: 'w-6 h-6' %}</span>
            <span class="font-sub text-[1rem] font-medium">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="text-[0.9375rem] leading-relaxed opacity-70">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DriveMist value props",
  "tag": "section",
  "class": "drivemist-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
