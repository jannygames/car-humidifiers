      "default": true,
      "info": "Below 640px the values become one row that advances on its own and loops."
    },
    {
      "type": "range",
      "id": "carousel_speed",
      "label": "Seconds per value",
      "min": 1.5,
      "max": 6,
      "step": 0.5,
      "unit": "s",
      "default": 2.5
    },
    {
      "type": "range",
      "id": "carousel_item_width",
