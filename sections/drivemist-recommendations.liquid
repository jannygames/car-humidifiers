{%- liquid
  assign s = section.settings

  comment
    Products come from Shopify's recommendation engine when there is a product in context,
    and from a chosen collection otherwise — the cart has no product of its own, so that
    is the path it takes.
  endcomment
  assign co_products = s.featured_collection.products
  if co_products.size == 0 and recommendations.performed and recommendations.products_count > 0
    assign co_products = recommendations.products
  endif
-%}

{%- if co_products.size > 0 -%}
  <section
    class="co {% render 'drivemist-surface', style: s.background_style %}"
    style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"
  >
    <div class="co-container co-section">
      {%- if s.eyebrow != blank or s.heading != blank -%}
        <div class="co-reveal max-w-2xl">
          {%- if s.eyebrow != blank -%}
            <p class="co-eyebrow text-accent">{{ s.eyebrow }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="co-display mt-3 text-[clamp(1.6rem,1.1rem+2vw,2.25rem)]">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign co_count = co_products.size
        if s.products_to_show < co_count
          assign co_count = s.products_to_show
        endif
        case co_count
          when 1
            assign co_cols = 'grid-cols-1'
          when 2
            assign co_cols = 'grid-cols-1 md:grid-cols-2'
          when 3
            assign co_cols = 'grid-cols-1 md:grid-cols-3'
          else
            assign co_cols = 'sm:grid-cols-2 lg:grid-cols-4'
        endcase
      -%}
      <div class="co-reco-grid mt-9 co-grid gap-x-6 gap-y-12 {{ co_cols }} lg:gap-x-8">
        {%- for p in co_products limit: s.products_to_show -%}
          {% render 'drivemist-product-card',
            product: p,
            section_id: section.id,
            index: forloop.index0,
            image_ratio: s.image_ratio,
            show_badge: s.show_badge,
            show_add_to_cart: s.show_add_to_cart,
            add_to_cart_label: s.add_to_cart_label,
            variant_dialog_title: s.variant_dialog_title,
            button_label: s.button_label,
            rating_fallback: s.rating_fallback
          %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "DriveMist recommendations",
  "tag": "section",
  "class": "drivemist-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Collection",
      "info": "Leave empty on a product page to use Shopify's related-product recommendations."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true,
      "info": "Products with one variant add straight from the card. Products with options open a dialog to pick one first."
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to basket"
    },
    {
      "type": "text",
      "id": "variant_dialog_title",
      "label": "Variant dialog title",
      "default": "Choose an option"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Secondary button label",
      "default": "Explore this product"
    },
    {
      "type": "text",
      "id": "rating_fallback",
      "label": "Rating text (before you have reviews)"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "shell",
          "label": "Shell"
        },
        {
          "value": "wash",
          "label": "Accent wash"
        },
        {
          "value": "deep",
          "label": "Deep purple"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "DriveMist recommendations"
    }
  ]
}
{% endschema %}
