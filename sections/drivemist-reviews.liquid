{%- liquid
  assign s = section.settings
-%}

<section
  class="co co-section {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"
  data-co-carousel

  {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}
>
  <div class="co-container">
    <div class="co-flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="co-reveal max-w-xl">
        {%- if s.eyebrow != blank -%}
          <p class="co-eyebrow text-accent">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="co-display mt-4 text-[clamp(1.85rem,1.1rem+3.1vw,3rem)]">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.show_summary -%}
          {%- liquid
            comment
              Real numbers when a review app has written the standard reviews metafields,
              the section's own text until then.
            endcomment
            assign co_mf = closest.product.metafields.reviews.rating
            assign co_count = closest.product.metafields.reviews.rating_count.value | default: 0 | plus: 0
            assign co_score = s.summary_score
            assign co_text = s.summary_text
            assign co_stars = 5
            if co_mf.value.rating != blank and co_count > 0
              assign co_scale = co_mf.value.scale_max | default: 5 | times: 1.0
              assign co_value = co_mf.value.rating | times: 1.0
              assign co_stars = co_value | times: 5.0 | divided_by: co_scale
              assign co_score = co_value | round: 1
              if co_count == 1
                assign co_text = 'Based on 1 verified review'
              else
                assign co_text = 'Based on ' | append: co_count | append: ' verified reviews'
              endif
            endif
          -%}
          <div class="mt-6 co-flex items-center gap-4">
            <span class="co-display text-[2.75rem] leading-none">{{ co_score }}</span>
            <span class="co-flex flex-col gap-1">
              <span class="text-accent">{% render 'drivemist-stars', rating: co_stars %}</span>
              <span class="text-[0.8125rem] text-muted">{{ co_text }}</span>
            </span>
          </div>
        {%- endif -%}
      </div>

      <div class="co-reveal co-flex items-center gap-3" data-co-carousel-nav hidden>
        <button
          type="button"
          class="co-flex h-11 w-11 items-center justify-center rounded-full border border-current/20 transition-colors hover:bg-current/5 disabled:opacity-30"
          data-co-carousel-prev
          aria-label="Previous reviews"
        >
          {% render 'drivemist-icon', icon: 'arrow-left', class: 'w-4 h-4' %}
        </button>
        <button
          type="button"
          class="co-flex h-11 w-11 items-center justify-center rounded-full border border-current/20 transition-colors hover:bg-current/5 disabled:opacity-30"
          data-co-carousel-next
          aria-label="Next reviews"
        >
          {% render 'drivemist-icon', icon: 'arrow-right', class: 'w-4 h-4' %}
        </button>
      </div>
    </div>
  </div>

  {%- assign co_app_blocks = section.blocks | where: 'type', '@app' -%}
  {%- if co_app_blocks.size > 0 -%}
    <div class="co-container mt-10 lg:mt-14">
      {%- for block in co_app_blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  {%- else -%}
  <div class="co-container mt-10 lg:mt-14">
    <div
      class="co-review-track co-scrollbar-none co-flex snap-x snap-mandatory gap-5 overflow-x-auto overflow-y-hidden pb-2"
      data-co-carousel-track
    >
      {%- for block in section.blocks -%}
        <figure
          class="co-reveal co-review-card co-flex shrink-0 flex-col rounded-card border border-current/12 bg-paper p-6 text-ink sm:p-7"
          style="transition-delay: {{ forloop.index0 | times: 70 }}ms"
          {{ block.shopify_attributes }}
        >
          <span class="text-accent">{% render 'drivemist-stars', rating: block.settings.rating %}</span>

          {%- if block.settings.title != blank -%}
            <figcaption class="font-sub mt-4 text-[1rem] font-medium">{{ block.settings.title }}</figcaption>
          {%- endif -%}

          <blockquote class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink/80">
            {{ block.settings.quote }}
          </blockquote>

          {%- if block.settings.image != blank -%}
            <div class="mt-5">
              {% render 'drivemist-image',
                image: block.settings.image,
                ratio: '16 / 10',
                class: 'co-media rounded-tile',
                sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 80vw',
                alt: block.settings.author
              %}
            </div>
          {%- endif -%}

          <div class="mt-5 co-flex items-center gap-3 border-t border-ink/8 pt-4">
            <span class="co-flex h-9 w-9 items-center justify-center rounded-full bg-accent-wash font-sub text-[0.8125rem] font-medium text-accent">
              {{ block.settings.author | slice: 0 }}
            </span>
            <span class="co-flex flex-col">
              <span class="text-[0.875rem] font-medium leading-tight">{{ block.settings.author }}</span>
              <span class="co-flex items-center gap-1 text-[0.75rem] leading-tight text-muted">
                {%- if block.settings.verified -%}
                  {% render 'drivemist-icon', icon: 'check-circle', class: 'w-3 h-3' %}
                {%- endif -%}
                {{ block.settings.meta }}
              </span>
            </span>
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>

  {%- endif -%}

  {%- if s.button_label != blank -%}
    <div class="co-container co-reveal mt-10 co-flex justify-center">
      <a href="{{ s.button_link | default: '#' }}" class="co-btn co-btn-primary">{{ s.button_label }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "DriveMist reviews",
  "tag": "section",
  "class": "drivemist-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Add your review app's block here and it replaces the placeholder reviews below. The score and count read from the standard reviews metafields, so they update automatically whichever app you use."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What drivers say about DriveMist car humidifiers."
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "text",
      "id": "summary_score",
      "label": "Score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Summary text",
      "default": "Based on 245 verified reviews"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "drivemist-reviews",
      "info": "Used for on-page links, e.g. #how-it-works."
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "shell",
          "label": "Shell"
        },
        {
          "value": "deep",
          "label": "Deep purple"
        },
        {
          "value": "ink",
          "label": "Ink"
        }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "default": "Two hours of quiet"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "The mist coming out of the exhausts looks unreal at night. Best gift I’ve found in years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Amanda R."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "Nissan GT-R Car Humidifier"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified icon",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "DriveMist reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Two hours of quiet",
            "quote": "The mist coming out of the exhausts looks unreal at night. Best gift I’ve found in years.",
            "author": "Amanda R.",
            "meta": "Nissan GT-R Car Humidifier"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Car smells amazing now",
            "quote": "I was sure it would smudge. Straight into the machine at 30° and it came out exactly as she drew it. She was so relieved.",
            "author": "Melissa K.",
            "meta": "Nissan GT-R Car Humidifier"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "The gift everyone asked about",
            "quote": "Three drops of vanilla oil and the whole cabin smells great for my commute.",
            "author": "Jessica P.",
            "meta": "Bugatti Chiron Car Humidifier"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Better quality than expected",
            "quote": "The detail on the grille and wheels is way better than I expected.",
            "author": "Katie M.",
            "meta": "Nissan GT-R Car Humidifier"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Lives on my desk now",
            "quote": "Works as a night light and a humidifier next to my monitors. Love it.",
            "author": "Sarah D.",
            "meta": "Verified buyer · The Canvas Mug"
          }
        }
      ]
    }
  ]
}
{% endschema %}
