{%- liquid
  assign s = section.settings
  if s.image_position == 'right'
    assign media_order = 'lg:order-2'
    assign text_order = 'lg:order-1'
  else
    assign media_order = 'lg:order-1'
    assign text_order = 'lg:order-2'
  endif
-%}

<section
  class="co co-section {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"

  {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}
>
  <div class="co-container">
    <div class="co-grid items-center gap-10 lg:grid-cols-2 lg:gap-16 xl:gap-24">
      <div class="co-reveal {{ media_order }}">
        <div class="relative">
          {% render 'drivemist-image',
            image: s.image,
            ratio: s.image_ratio,
            class: 'co-media rounded-card',
            sizes: '(min-width: 1024px) 50vw, 100vw',
            alt: s.image_alt,
            placeholder: 'lifestyle-2'
          %}
          {%- if s.image_secondary != blank -%}
            <div class="absolute -bottom-8 -right-4 co-hide w-[42%] sm:block lg:-right-8">
              {% render 'drivemist-image',
                image: s.image_secondary,
                ratio: '1 / 1',
                class: 'co-media rounded-tile ring-8 ring-[var(--co-paper)]',
                sizes: '25vw',
                alt: s.image_alt
              %}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="co-reveal {{ text_order }} max-w-[34rem]">
        {%- if s.eyebrow != blank -%}
          <p class="co-eyebrow text-accent">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="co-display mt-4 text-[clamp(1.85rem,1.1rem+3.1vw,3rem)]">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="co-rte mt-5 text-[1.0625rem] leading-relaxed text-muted">{{ s.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="mt-8 co-flex flex-col divide-y divide-current/10 border-y border-current/10">
            {%- for block in section.blocks -%}
              <li class="co-flex items-start gap-4 py-4" {{ block.shopify_attributes }}>
                <span class="mt-0.5 co-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-wash text-accent">
                  {% render 'drivemist-icon', icon: block.settings.icon, class: 'w-4 h-4' %}
                </span>
                <span class="co-flex flex-col gap-1">
                  <span class="font-sub text-[0.9375rem] font-medium">{{ block.settings.title }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="text-[0.9375rem] leading-relaxed text-muted">{{ block.settings.text }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.button_label != blank -%}
          <div class="mt-9">
            {%- liquid
              case s.button_style
                when 'brand'
                  assign co_btn_class = 'co-btn-brand'
                when 'accent'
                  assign co_btn_class = 'co-btn-accent'
                when 'ghost'
                  assign co_btn_class = 'co-btn-ghost'
                else
                  assign co_btn_class = 'co-btn-primary'
              endcase
            -%}
            <a href="{{ s.button_link | default: '#' }}" class="co-btn {{ co_btn_class }}">
              {{ s.button_label }}
              {% render 'drivemist-icon', icon: 'arrow-right', class: 'w-4 h-4' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
