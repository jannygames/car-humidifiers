{%- liquid
  assign s = section.settings
-%}

<section
  class="co co-section {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"

  {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}
>
  <div class="co-container">
    <div class="co-grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="co-reveal max-w-[32rem]">
        {%- if s.eyebrow != blank -%}
          <p class="co-eyebrow {% if s.background_style == 'ink' %}opacity-70{% else %}text-accent{% endif %}">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="co-display mt-4 text-[clamp(1.75rem,1.1rem+2.6vw,2.75rem)]">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="co-rte mt-4 text-[1rem] leading-relaxed opacity-75">{{ s.text }}</div>
        {%- endif -%}

        {%- form 'customer', class: 'mt-8' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">

          {%- if form.posted_successfully? -%}
            <p class="co-flex items-center gap-2 rounded-2xl bg-current/8 px-5 py-4 text-[0.9375rem]">
              {% render 'drivemist-icon', icon: 'check-circle', class: 'w-4 h-4' %}
              {{ s.success_text }}
            </p>
          {%- else -%}
            <div class="co-flex flex-col gap-3 sm:flex-row">
              <label class="sr-only" for="DriveMistNewsletter-{{ section.id }}">{{ s.placeholder }}</label>
              <input
                id="DriveMistNewsletter-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ s.placeholder }}"
                autocomplete="email"
                required
                class="co-input h-[3.5rem] w-full rounded-full px-6 sm:flex-1"
              >
              <button type="submit" class="co-btn {% if s.background_style == 'ink' %}bg-paper text-ink shadow-lift{% else %}co-btn-primary{% endif %} h-[3.5rem] shrink-0 px-8 text-[1rem]">
                {{ s.button_label }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="mt-3 text-[0.8125rem] text-accent">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}

          {%- if s.disclaimer != blank -%}
            <p class="mt-4 text-[0.75rem] leading-relaxed opacity-60">{{ s.disclaimer }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- if s.show_image -%}
        <div class="co-reveal">
          {% render 'drivemist-image',
            image: s.image,
            ratio: '5 / 4',
            class: 'co-media rounded-card',
            sizes: '(min-width: 1024px) 48vw, 100vw',
            alt: s.heading,
            placeholder: 'lifestyle-2'
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DriveMist newsletter",
  "tag": "section",
  "class": "drivemist-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "10% off your first order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save 10% and keep creativity flowing."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Join the DriveMist garage for 10% off your first order, new model drops and restock alerts.</p>"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my 10% code"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "You’re in — check your inbox for your code."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Expect one or two emails a month. Unsubscribe at any time."
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Used for on-page links, e.g. #how-it-works."
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "shell",
          "label": "Shell"
        },
        {
          "value": "deep",
          "label": "Deep purple"
        },
        {
          "value": "ink",
          "label": "Ink"
        },
        {
          "value": "wash",
          "label": "Accent wash"
        }
      ],
      "default": "wash"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "DriveMist newsletter"
    }
  ]
}
{% endschema %}
