{%- liquid
  assign s = section.settings
-%}

<section
  class="co co-section {% render 'drivemist-surface', style: s.background_style %}"
  style="{% render 'drivemist-pad', padding_top: s.padding_top, padding_bottom: s.padding_bottom %}"

  {% if s.anchor != blank %}id="{{ s.anchor }}"{% endif %}
>
  <div class="co-container">
    {%- liquid
      assign has_intro = false
      if s.badge or s.eyebrow != blank or s.heading != blank or s.text != blank or s.button_label != blank
        assign has_intro = true
      endif
    -%}
    {%- if has_intro -%}
    <div class="co-reveal mx-auto co-flex max-w-3xl flex-col items-center text-center">
      {%- if s.badge != blank -%}
        <span class="mb-7 co-flex h-16 w-16 items-center justify-center rounded-full border border-current/20">
          {% render 'drivemist-icon', icon: s.icon, class: 'w-7 h-7' %}
        </span>
      {%- endif -%}
      {%- if s.eyebrow != blank -%}
        <p class="co-eyebrow opacity-70">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="co-display mt-4 text-[clamp(1.85rem,1.1rem+3.1vw,3rem)]">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="co-rte mt-5 text-[1.0625rem] leading-relaxed opacity-80">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank -%}
        <a
          href="{{ s.button_link | default: '#' }}"
          class="co-btn mt-9 {% if s.background_style == 'ink' %}bg-paper text-ink hover:opacity-90{% else %}co-btn-primary{% endif %}"
        >
          {{ s.button_label }}
        </a>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="co-grid gap-8 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4 {% if has_intro %}mt-14 border-t border-current/15 pt-10{% endif %}">
        {%- for block in section.blocks -%}
          <div
            class="co-reveal co-flex flex-col items-center gap-3 text-center"
            style="transition-delay: {{ forloop.index0 | times: 90 }}ms"
            {{ block.shopify_attributes }}
          >
            {% render 'drivemist-icon', icon: block.settings.icon, class: 'w-5 h-5 opacity-70' %}
            <span class="font-sub text-[0.9375rem] font-medium">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}
              <span class="text-[0.875rem] leading-relaxed opacity-70">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

